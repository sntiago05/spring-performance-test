    {
      "id": 18,
      "type": "timeseries",
      "title": "JVM heap used",
      "description": "Current JVM heap memory in use by service, shown in bytes. This excludes non-heap memory; compare with each service's configured heap limit when reviewing capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
