      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(helpflow_tickets_escalated_total[5m]))",
          "legendFormat": "escalated",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(helpflow_tickets_sla_breached_total[5m]))",
          "legendFormat": "breached",
