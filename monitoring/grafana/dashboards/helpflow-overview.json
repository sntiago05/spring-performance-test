    {
      "id": 19,
      "type": "timeseries",
      "title": "Process CPU usage",
      "description": "CPU used by each service process as a fraction of one available CPU core: 0.5 represents 50%. This process-level metric is not total host CPU usage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 40
      },
      "targets": [
