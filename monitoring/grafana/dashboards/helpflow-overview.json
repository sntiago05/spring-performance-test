    {
      "id": 12,
      "type": "bargauge",
      "title": "Tickets registered by category and priority (last hour)",
      "description": "Estimated number of newly registered tickets during the rolling last hour, grouped by category and priority. Each bar is a ticket count; an empty category means no matching tickets were recorded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (category, priority) (increase(helpflow_tickets_registered_total[1h]))",
          "legendFormat": "{{category}} / {{priority}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Mean first response and resolution time",
      "description": "Average elapsed time from ticket creation to a technician's first response and to resolution, in seconds. Each line uses events observed in a rolling 15-minute window; it will be empty when there are no matching events.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(helpflow_tickets_first_response_seconds_sum[15m])) / sum(rate(helpflow_tickets_first_response_seconds_count[15m]))",
          "legendFormat": "mean first response",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(helpflow_tickets_resolution_seconds_sum[15m])) / sum(rate(helpflow_tickets_resolution_seconds_count[15m]))",
          "legendFormat": "mean resolution",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Assignments by source",
      "description": "Estimated number of ticket assignments in the rolling last 5 minutes, grouped by source: DISPATCH is a suggestion from technician-dispatch-service, RULES is an internal rule, and MANUAL is an administrator assignment. Counter increases may be fractional estimates between scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source) (increase(helpflow_tickets_assigned_total[5m]))",
