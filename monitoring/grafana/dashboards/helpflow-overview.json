          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Authentication failures and access denied",
      "description": "Shows authentication failures by reason and authorization denials (403) over the rolling last 5 minutes. The two series represent separate security events.",
