      "id": 15,
      "type": "timeseries",
      "title": "Escalations and SLA breaches",
      "description": "Compares estimated escalation and SLA-breach event counts over the rolling last 5 minutes. Counter increases may be fractional estimates between scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
