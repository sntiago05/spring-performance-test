# Copy to .env (git-ignored) and fill in, or run ./scripts/setup-env.sh to generate random values.
# Nothing in this file is a real secret.

# PostgreSQL
DB_USER=helpflow
DB_PASSWORD=change-me
DB_HOST_PORT=5433

# JWT signing key: at least 32 characters (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Optional first-run accounts. Leave a password empty to skip creating those accounts.
# Admin login: BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD
# Technician logins: tec-001@helpflow.example ... tec-015@helpflow.example share BOOTSTRAP_TECHNICIAN_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@helpflow.example
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TECHNICIAN_PASSWORD=

# Grafana admin password (user: admin)
GRAFANA_ADMIN_PASSWORD=change-me

# Published ports on the host
FRONTEND_PORT=4200
SUPPORT_TICKET_PORT=8080
DISPATCH_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
